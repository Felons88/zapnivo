# Public site URL used for canonical links, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://www.zapnivo.com

# Google Analytics 4 measurement ID (stream: zapnivo / G-…). Loads gtag only
# after cookie consent; leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager container ID (GTM-…). Loads after cookie consent and
# shares the dataLayer with GA4; leave unset to disable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Apex domain for subdomain routing (src/proxy.ts). support/internal/partners/api
# subdomains are served from this base. Leave unset for zapnivo.com; set it if the
# whole deployment ever moves to a different apex domain.
# BASE_DOMAIN=zapnivo.com

# Mapbox — public token (pk.*) for the network map and city/ZIP search.
# Create at account.mapbox.com and restrict it to your site URL(s).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# Supabase — required for form storage, auth, portals
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SERVICE ROLE key — server-side only, NEVER expose in client code or commit real values
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — when rentals launch (test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Kiosk integration — to be defined once manufacturer docs are reviewed
KIOSK_ADAPTER=none

# AI support assistant (OpenRouter) — server-only; never prefix with NEXT_PUBLIC_
# Create a key at openrouter.ai/keys. The model must support tool calling.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Helpdesk
# 32+ random bytes (e.g. `openssl rand -hex 32`). Signs customer conversation links. REQUIRED in production.
HELPDESK_SECRET=
# Email delivery (Resend). Without these, outgoing emails stay queued in the outbox; nothing is claimed as sent.
RESEND_API_KEY=
BREVO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1
KIOSK_INGEST_SECRET=
# Legacy shared-secret ingest fallback — keep UNSET once devices use per-device
# HMAC credentials (X-Device-* headers). Set to "1" only during migration.
# KIOSK_LEGACY_INGEST=
# AES-256 key (64 hex chars) that encrypts per-device kiosk credential secrets
# at rest. REQUIRED before issuing device credentials via System Control.
DEVICE_CREDENTIAL_KEK=
# Zero-downtime credential rotation overlap window, in hours. During this window
# BOTH the current and staged-next device credential verify; the first auth with
# the new secret promotes it. Default 72, clamped to 1–168; invalid → 72.
# DEVICE_CREDENTIAL_ROTATION_WINDOW_HOURS=72
# One-time privileged bootstrap token for /system/security/bootstrap.
# Set, use once, then unset. Never commit a real value.
# SYSTEM_BOOTSTRAP_TOKEN=
CRON_SECRET=
# External alert fallback webhook (Slack-compatible JSON POST). Used when the
# in-app incident + Brevo pipeline may be down. 15-min per-key cooldown.
ALERT_WEBHOOK_URL=
# Override cooldown ms if needed
# ALERT_COOLDOWN_MS=900000

SUPPORT_FROM_EMAIL="Zapnivo <hello@zapnivo.com>"
# Inbound support-email webhook (/api/webhooks/email/inbound?key=...). Required in
# production or the route answers 503. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_INBOUND_SECRET=
# LOCAL DEVELOPMENT ONLY: use a JSON-file store + synthetic staff/partner sign-in (no Supabase needed).
# Ignored in production builds. Data is stored in .data/helpdesk.json. NEVER use real customer data with this.
# HELPDESK_DEV_STORE=1

# System control plane — one-time privileged bootstrap (/system/security/bootstrap).
# Long random value (e.g. `openssl rand -hex 32`). Required, together with a
# verified TOTP factor, to self-grant profiles.system_role='sysadmin' when no
# system role exists. Leave UNSET to disable self-service bootstrap (manual
# service-role grant is then the documented procedure). Never commit a real value.
SYSTEM_BOOTSTRAP_TOKEN=

# Payments (Stripe) - server-only; never prefix with NEXT_PUBLIC_. Without STRIPE_SECRET_KEY every payment route answers 503 payments_unconfigured.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Set to 1 only after Stripe Tax is configured; enables Checkout automatic_tax. Otherwise tax is not applied and receipts say so.
STRIPE_TAX_ENABLED=
